{
  "name": "apishot",
  "productName": "ApiShot",
  "version": "1.0.0",
  "private": true,
  "description": "Aplicação desktop local para gerenciar e enviar campanhas pelo WhatsApp Web para contatos que autorizaram receber mensagens.",
  "type": "module",
  "main": "dist/main/electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "start": "electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.electron.json --noEmit",
    "package": "npm run build && electron-builder",
    "package:dir": "npm run build && electron-builder --dir",
    "setup:browser": "playwright-core install chromium"
  },
  "dependencies": {
    "papaparse": "^5.7.0",
    "playwright-core": "^1.63.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "local.apishot",
    "productName": "ApiShot",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "!**/*.map"
    ],
    "asarUnpack": [
      "node_modules/playwright-core/**"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.business"
    },
    "linux": {
      "target": "AppImage",
      "category": "Office"
    }
  },
  "engines": {
    "node": ">=20.19"
  }
}
